{"id":"smoke.compile_success.basic","description":"Baseline case should compile.","expect":"compile_success","code":"void Main() {\n  int value = 1 + 2;\n  print(value);\n}"}
{"id":"smoke.compile_success.loop","description":"Basic loops should compile.","expect":"compile_success","code":"void Main() {\n  int sum = 0;\n  for (int i = 0; i < 5; i++) {\n    sum += i;\n  }\n  print(sum);\n}"}
{"id":"smoke.compile_success.function_call","description":"Simple function call should compile.","expect":"compile_success","code":"int Add(int a, int b) {\n  return a + b;\n}\n\nvoid Main() {\n  print(Add(2, 3));\n}"}
{"id":"smoke.compile_success.namespace_call","description":"Basic namespace call should compile.","expect":"compile_success","code":"void Main() {\n  UI::Text(\"cross-suite smoke\");\n}"}
{"id":"smoke.compile_error.type_mismatch","description":"Intentional type mismatch should fail compilation.","expect":"compile_error","code":"void Main() {\n  int value = \"oops\";\n  print(value);\n}"}
{"id":"smoke.compile_error.unknown_symbol","description":"Unknown function call should fail.","expect":"compile_error","code":"void Main() {\n  NotARealFunction();\n}"}
{"id":"smoke.compile_error.reserved_keyword","description":"Reserved keyword local declaration should fail.","expect":"compile_error","code":"void Main() {\n  int if = 1;\n}"}
{"id":"smoke.compile_error.unclosed_block","description":"Unclosed block should fail.","expect":"compile_error","code":"void Main() {\n  if (true) {\n    print(\"oops\");\n}"}
